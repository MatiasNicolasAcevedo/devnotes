# Ejemplo de configuración local de Starter. Copiar a .env (ignorado por Git) solo si hace falta
# cambiar algún valor: docker-compose.yml ya trae estos mismos defaults. Valores ficticios de desarrollo;
# nunca poner aquí credenciales reales.

# Base de datos de desarrollo (volumen persistente starter_db-data)
POSTGRES_DB=starter
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter-dev-only

# Puertos publicados solo en loopback (127.0.0.1) del host
DB_PORT=55432
# Only compose.diagnostic.yml publishes the server; forwarding is disabled there.
DIAGNOSTIC_SERVER_PORT=8080
# Origen público del navegador (client: SPA + proxy a server) y desarrollo con HMR (perfil dev)
CLIENT_PORT=5173
CLIENT_DEV_PORT=5174
APP_PUBLIC_URL=http://127.0.0.1:5173

# OpenAPI/Swagger UI (ADR 0003): false por defecto. true solo para desarrollo local con APP_PUBLIC_URL HTTP
# loopback (localhost, 127.0.0.1, [::1]); con HTTPS u otro host el server no arranca. Publica únicamente
# GET ${APP_PUBLIC_URL}/api/docs/swagger-ui.html y /api/docs/openapi. Ver docs/SETUP.md.
STARTER_API_DOCS_ENABLED=false

# Runner de pruebas backend (scripts/verify.sh): container | host
# container = Testcontainers desde el contenedor server-tests (camino por defecto)
# host      = alternativa preaprobada: ./mvnw clean verify con el JDK 21 del host (ver docs/TESTING.md)
STARTER_SERVER_TESTS=container

# Google real: values must be supplied privately to the backend; empty defaults fail without mock fallback.
# This versioned example NEVER contains real credentials. Owner setup and smoke: docs/SETUP.md (S-03 guide).
# Authorized redirect URI must be exactly ${APP_PUBLIC_URL}/login/oauth2/code/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# To use Vite HMR auth, choose APP_PUBLIC_URL=http://127.0.0.1:5174 for server AND proxy.
# One public origin at a time. Provider mock is exclusive to compose.auth-test.yml/test/e2e.

# Voice — disabled by default; only transmitted to the server container (S-105).
# Activation requires explicit configuration; empty defaults do not break startup.
DEVNOTES_VOICE_ENABLED=false
GROQ_API_KEY=

# OCR (S-112) — disabled by default. For authorized activation use work,personal or a subset.
DEVNOTES_OCR_ENABLED=false
DEVNOTES_OCR_ALLOWED_SPACES=
OCR_SPACE_API_KEY=

# S-116. Confirmar las cuentas Free antes de habilitar las consultas.
# PILOT_ID es el UUID local. EXCERPT_SCOPES acepta work/daily,work/free,personal/daily,personal/free.
DEVNOTES_AI_ENABLED=false
DEVNOTES_AI_PILOT_ID=
DEVNOTES_AI_GROQ_ENABLED=false
DEVNOTES_AI_GROQ_EXCERPT_SCOPES=
DEVNOTES_AI_WORKERS_ENABLED=false
DEVNOTES_AI_WORKERS_EXCERPT_SCOPES=
DEVNOTES_AI_GEMINI_ENABLED=false
DEVNOTES_AI_GEMINI_EXCERPT_SCOPES=
DEVNOTES_AI_OPENROUTER_ENABLED=false
DEVNOTES_AI_OPENROUTER_EXCERPT_SCOPES=
GROQ_AI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Service activity window (S-111) — disabled by default; only for the operator-enabled owner.
# DEVNOTES_KEEP_AWAKE_OWNER_ID is the local app_user UUID of that account (never an email or claim).
# Enabled without a valid UUID leaves the capability unavailable without breaking startup. Fictitious example:
# DEVNOTES_KEEP_AWAKE_OWNER_ID=01900000-0000-7000-8000-00000000abcd
DEVNOTES_KEEP_AWAKE_ENABLED=false
DEVNOTES_KEEP_AWAKE_OWNER_ID=
